<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="#423559"
    android:layout_height="match_parent"
    tools:context=".Signin">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" ❇️Signin❇️ "
        android:fontFamily="cursive"
        android:textSize="47sp"
        android:textAlignment="center"
        android:background="@drawable/shape"

        android:textStyle="italic|bold"
        android:textColor="#5C19D5"/>
<!--    Below is a card view-->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:contentPadding="10dp">
<!--        Below is a linear layout that shall align contents vertically-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="vertical">
<!--            Below is the email EditText-->

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="📧 Enter Email Address"
                android:textColorHint="#000"
                android:id="@+id/email"
                android:textColor="#000"
                android:layout_margin="8dp"
                android:background="#567"
                android:padding="11dp"
                android:inputType="textEmailAddress"/>

<!--            Below is the password EditText-->

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="🔑 Enter Your Password"
                android:textColorHint="#000"
                android:id="@+id/password"
                android:textColor="#000"
                android:layout_margin="8dp"
                android:background="#567"
                android:padding="11dp"
                android:inputType="textPassword"/>

<!--            Below is the signin button-->


            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="50dp"
                android:layout_marginRight="50dp"
                android:layout_marginTop="30dp"
                android:padding="10dp"

                android:text="🧑‍✈️ SIGNIN"
                android:textColor="#03A9F4"
                android:textSize="25sp"
                android:backgroundTint="#222424"
                android:id="@+id/signinBtn"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="@string/signup_text"
                android:textAlignment="center"
                android:textSize="23sp"
                android:layout_marginTop="25dp"
                android:textColor="#7f8cff"
                android:id="@+id/signuptxt"/>



        </LinearLayout>

    </androidx.cardview.widget.CardView>
</LinearLayout>